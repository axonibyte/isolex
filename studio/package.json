{
  "name": "isolex-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "isolex studio's interface, in the Tauri shell's window (src-tauri).",
  "scripts": {
    "core": "cargo build --release --locked -p isolex-studio-wasm --target wasm32-unknown-unknown --manifest-path ../Cargo.toml && node -e \"require('fs').copyFileSync('../target/wasm32-unknown-unknown/release/isolex_studio_wasm.wasm', 'ui/src/lib/studio-core.wasm')\"",
    "predev": "npm run core",
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "pretest": "npm run core",
    "test": "vitest run",
    "pree2e": "npm run core",
    "e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
