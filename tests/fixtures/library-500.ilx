// 500 icons for timing the studio (#71): written by
// studio-core/tests/scale.rs; UPDATE_GOLDENS=1 writes it again.

lexicon {
  tokens "ink" "ink-muted" "outline" "body-top" "body-left" "body-right" "accent"
  stroke-widths 1.2 1.4
}

fragment "led-row" {
  param n 4
  param z 0.1
  part "leds" {
    repeat "n" "i" {
      facerect "front" "0.1 + i * (1.8 / n)" 1 "z" 0.08 0.08 fill="ink" opacity=0.6
    }
  }
}

axis "state" {
  variant "down" {
    part "state-badge" {
      badge "state-down" corner="ne"
    }
  }
  variant "planned" {
    part "state-badge" {
      badge "state-planned" corner="ne"
    }
  }
}

icon "state-down" {
  category "state"
  canvas 24 24
  part "x" {
    at 0 0 0 {
      circle 12 12 8 fill="accent"
      path d="M8,8 L16,16 M16,8 L8,16" stroke="ink" width=1.4
    }
  }
}

icon "state-planned" {
  category "state"
  canvas 24 24
  part "x" {
    at 0 0 0 {
      rect 3 3 18 18 rx=3 stroke="ink-muted" width=1.4
    }
  }
}

base "rack-0" {
  category "rack"
  param u 1
  footprint 2 1 "u * 0.28"
  part "chassis" {
    box 0 0 0 2 1 "u * 0.28"
  }
}

base "rack-1" {
  category "rack"
  param u 2
  footprint 2 1 "u * 0.28"
  part "chassis" {
